# Risk Studio v5 API: every request goes to the front controller.
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Run the parent rules first (HTTPS redirect of the site's .htaccess):
    # a child .htaccess does not inherit rewrite rules otherwise.
    RewriteOptions InheritBefore
    # Pass the Authorization header to PHP under FastCGI (collector trigger).
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Only the front controller may be reached directly.
<FilesMatch "^(?!index\.php$).+\.php$">
    Require all denied
</FilesMatch>
