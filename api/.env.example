# Risk Studio v5 API configuration.
# Copy to `.env` and keep it OUTSIDE the web root in production.

APP_ENV=dev
APP_VERSION=5.0.0-dev
# Path prefix under which the API is served (Apache /api/, Vite proxy /api/).
API_BASE_PATH=/api
# 64 random characters, never shared: signs rate-limit buckets.
# Generate with: php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
APP_SECRET=change-me-with-64-random-characters
# Session cookie flag. Defaults to Secure except when APP_ENV=dev.
# COOKIE_SECURE=1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=riskstudio

# Public API: read-only views + proposal insert.
DB_READ_USER=rs_read
DB_READ_PASSWORD=change-me-read

# Admin back-office and collector.
DB_WRITE_USER=rs_write
DB_WRITE_PASSWORD=change-me-write

# Migrations only (DDL). Never used by the web runtime.
DB_ADMIN_USER=rs_admin
DB_ADMIN_PASSWORD=change-me-admin

# Collector (api/bin/collect.php, scheduled every 15 minutes)
# Seconds a run may last: keep it below the hosting limit for scheduled tasks.
COLLECTOR_TIME_BUDGET=50
# History imported on the very first run of a source.
COLLECTOR_BACKFILL_DAYS=30
# Ransomware claims kept (ISO 3166 alpha-2, comma separated, empty = all).
COLLECTOR_LEAK_COUNTRIES=BE,FR,NL,LU,DE
# Optional, free: https://nvd.nist.gov/developers/request-an-api-key
# Without key: 5 NVD lookups per run. With key: 40.
NVD_API_KEY=
