# Risk Studio v5 API configuration.
# Copy to `.env` and keep it OUTSIDE the web root in production.

APP_ENV=dev
APP_VERSION=5.0.0-dev
# Path prefix under which the API is served (Apache /api/, Vite proxy /api/).
API_BASE_PATH=/api

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=riskstudio

# Public API: read-only views + proposal insert.
DB_READ_USER=rs_read
DB_READ_PASSWORD=change-me-read

# Admin back-office and collector.
DB_WRITE_USER=rs_write
DB_WRITE_PASSWORD=change-me-write

# Migrations only (DDL). Never used by the web runtime.
DB_ADMIN_USER=rs_admin
DB_ADMIN_PASSWORD=change-me-admin
