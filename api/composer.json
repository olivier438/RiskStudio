{
    "name": "onecircle/riskstudio-api",
    "description": "Risk Studio v5 API: GRC risk catalogue and deterministic threat intelligence feed.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "RiskStudio\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RiskStudio\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
